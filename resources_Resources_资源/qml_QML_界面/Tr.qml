    // -----------------------------------------------------------------------
    //  Lookup
    //  查表
    // -----------------------------------------------------------------------
    //  Returns the localised string for `key`. Falls back to the other
    //  language, then to the key itself, so a missing translation is visible
    //  but never fatal.
    //  返回 `key` 对应的本地化字符串。依次回退到另一种语言、最后回退到 key 本身，
    //  因此缺失的翻译可见但不会导致失败。
    function t(key) {
        var table = chinese ? zh : en
        var value = table[key]
        if (value !== undefined)
            return value
        var fallback = chinese ? en : zh
        if (fallback[key] !== undefined)
            return fallback[key]
        return key
    }

    //  Formats a localised string with %1..%9 substitutions. Qt's own
    //  `arg()` is used so behavioural parity with C++ is preserved.
    //  使用 %1..%9 占位符格式化本地化字符串。使用 Qt 自带的 `arg()`，以保持与
    //  C++ 侧行为一致。
    function tf(key, values) {
        var text = t(key)
        if (values === undefined || values === null)
            return text
        var list = (values instanceof Array) ? values : [values]
        for (var i = 0; i < list.length; ++i)
            text = text.arg(list[i])
        return text
    }

    //  True when the key exists in the active language.
    //  当该键在当前语言中存在时返回 true。
    function has(key) {
        return (chinese ? zh : en)[key] !== undefined
    }
}
